{
  "author": "igorlogius",
  "homepage_url": "https://github.com/igorlogius/webextensions/tree/main/get-tabs-infos",
  "background": {
    "scripts": ["install.js", "background.js"],
    "type": "module"
  },

  "browser_action": {
    "browser_style": false,
    "default_area": "navbar",
    "default_popup": "popup.html"
  },

  "commands": {
    "0": {
      "description": "Custom Action 1"
    },
    "1": {
      "description": "Custom Action 2"
    },
    "2": {
      "description": "Custom Action 3"
    },
    "3": {
      "description": "Custom Action 4"
    },
    "4": {
      "description": "Custom Action 5"
    },
    "5": {
      "description": "Custom Action 6"
    },
    "6": {
      "description": "Custom Action 7"
    },
    "7": {
      "description": "Custom Action 8"
    },
    "8": {
      "description": "Custom Action 9"
    },
    "9": {
      "description": "Custom Action 10"
    },
    "10": {
      "description": "Custom Action 11"
    },
    "11": {
      "description": "Custom Action 12"
    }
  },
  "icons": {
    "256": "icon.png"
  },
  "manifest_version": 2,
  "name": "Get Tabs Infos",
  "options_ui": {
    "open_in_tab": false,
    "page": "options.html"
  },

  "description": "Get tabs information in custom formats",
  "permissions": ["clipboardWrite", "tabs", "storage"],
  "version": "1.12.23"
}
