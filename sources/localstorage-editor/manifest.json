{
  "options_ui": {
    "page": "welcome.html"
  },
  "author": "igorlogius",
  "browser_specific_settings": {
    "gecko": {
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },
  "homepage_url": "https://github.com/igorlogius/webextensions/tree/main/sources/localstorage-editor",
  "background": {
    "scripts": ["install.js", "background.js"]
  },
  "browser_action": {
    "default_area": "navbar"
  },
  "commands": {
    "_execute_browser_action": {}
  },
  "content_scripts": [
    {
      "js": ["content.js"],
      "matches": ["<all_urls>"]
    }
  ],
  "icons": {
    "128": "icon.png"
  },
  "description": "Add, edit, copy, remove, export and import local- and session- storage data",
  "manifest_version": 2,
  "name": "LocalStorage Editor",
  "permissions": ["storage", "clipboardRead", "clipboardWrite", "<all_urls>"],
  "version": "1.3.22"
}
