{
  "author": "igorlogius",
  "browser_specific_settings": {
    "gecko": {
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },
  "homepage_url": "https://github.com/igorlogius/webextensions/tree/main/sources/load-background-tabs-on-select",
  "description": "Prevents background tabs from loading until they have been activated",
  "background": {
    "scripts": ["install.js", "background.js"],
    "type": "module"
  },
  "browser_action": {
    "default_area": "navbar"
  },
  "icons": {
    "32": "icon.svg",
    "64": "icon.svg",
    "128": "icon.svg"
  },
  "manifest_version": 2,
  "name": "Load Background Tabs on Select",
  "options_ui": {
    "page": "options.html"
  },
  "permissions": ["storage", "tabs"],
  "version": "1.2.13"
}
