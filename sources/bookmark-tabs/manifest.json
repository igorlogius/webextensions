{
  "options_ui": {
    "page": "welcome.html"
  },
  "author": "igorlogius",
  "homepage_url": "https://github.com/igorlogius/webextensions/tree/main/bookmark-tabs",
  "background": {
    "scripts": ["install.js", "background.js"]
  },
  "browser_action": {
    "default_area": "navbar",
    "default_popup": "popup.html"
  },
  "description": "Saves selected or all tabs into a timestamped bookmark folder",
  "icons": {
    "128": "icon.png"
  },
  "manifest_version": 2,
  "name": "Bookmark Tabs",
  "permissions": ["menus", "tabs", "bookmarks", "storage"],
  "optional_permissions": ["notifications"],
  "commands": {
    "_execute_browser_action": {},
    "bookmark-tabs": {}
  },
  "version": "1.6.22"
}
