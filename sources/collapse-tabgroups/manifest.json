{
  "options_ui": {
    "page": "welcome.html"
  },
  "author": "igorlogius",
  "browser_specific_settings": {
    "gecko": {
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },
  "homepage_url": "https://github.com/igorlogius/webextensions/tree/main/sources/collapse-tabgroups",
  "browser_action": {
    "default_area": "navbar"
  },
  "background": {
    "scripts": ["install.js", "background.js"]
  },
  "commands": {
    "_execute_browser_action": {}
  },
  "icons": {
    "1024": "icon.png"
  },
  "description": "Control the collapse state of tabgroups",
  "manifest_version": 2,
  "name": "Collapse Tabgroups",
  "permissions": ["menus", "tabs", "tabGroups"],
  "version": "1.0.2"
}
