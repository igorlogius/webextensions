{
  "author": "igorlogius",
  "browser_specific_settings": {
    "gecko": {
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },
  "icons": {
    "266": "icon.png"
  },
  "background": {
    "scripts": ["install.js", "feed-parser.js", "background.js"]
  },
  "browser_action": {
    "default_area": "navbar",
    "default_title": "- Left Mouse Button open in popup window\n- Middle Mouse Button open in tab"
  },
  "commands": {
    "_execute_browser_action": {}
  },
  "description": "Find RSS, ATOM and JSON feeds",
  "homepage_url": "https://github.com/igorlogius/webextensions/tree/main/find-feeds",
  "manifest_version": 2,
  "name": "Find Feeds",
  "options_ui": {
    "open_in_tab": true,
    "page": "options.html"
  },
  "permissions": ["storage", "<all_urls>", "webRequest", "webRequestBlocking"],
  "version": "1.5.0"
}
